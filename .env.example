# คัดลอกเป็น .env ที่ root ของ repo แล้วตั้งค่าตาม environment (ห้าม commit .env)
# ค่าด้านล่างใช้กับ mock backend สำหรับการพัฒนาเท่านั้น ต้องเปลี่ยนเมื่อนำไปใช้งานจริง
ADMIN_MOCK_TOKEN=mock-admin-token

# --- SonarQube scanner (local test, ห้าม commit token จริง) ---
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=sqp_xxx